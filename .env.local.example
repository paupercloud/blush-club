# Público — se puede exponer en el navegador (solo permite leer datos públicos, RLS protege el resto)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# SECRETO — nunca lo pongas en el navegador. Solo se usa dentro del servidor
# (server actions / API routes) para tareas puntuales de administración inicial.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
